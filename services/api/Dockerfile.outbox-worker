FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=0 \
    UV_LINK_MODE=copy

RUN pip install --no-cache-dir uv

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY . .

STOPSIGNAL SIGTERM

ENTRYPOINT ["uv", "run", "--frozen", "python", "manage.py"]
CMD ["run_outbox_worker", "--poll-interval", "2", "--limit", "20", "--lease-seconds", "60"]
